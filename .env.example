NEXT_PUBLIC_SITE_URL=https://www.cardioahead.com
# Server-only values. Never prefix these with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY remains supported as a fallback.
CARDIOAHEAD_SESSION_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=CardioAhead <login@cardioahead.com>
# Local-only synthetic storage. Always disabled on Vercel.
CARDIOAHEAD_LOCAL_TEST=false
CARDIOAHEAD_LOCAL_DATA_DIR=.local-test-data
# Automated tests alone use a loopback mock Resend endpoint.
# CARDIOAHEAD_TEST_RESEND_URL=http://127.0.0.1:3199/emails

# Approved fictional-document AI processing. Provider keys remain server-only.
CARDIOAHEAD_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CARDIOAHEAD_ENABLE_CLAUDE_TEST_PDFS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
CARDIOAHEAD_ENABLE_OPENAI_TEST_PDFS=false