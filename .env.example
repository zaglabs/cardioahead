NEXT_PUBLIC_SITE_URL=https://cardioahead.com
# Server-only values. Never prefix these with NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARDIOAHEAD_SESSION_SECRET=
# Local-only synthetic end-to-end tests. Hosted deployments always reject this mode.
CARDIOAHEAD_LOCAL_TEST=false
CARDIOAHEAD_LOCAL_PASSWORD=
CARDIOAHEAD_LOCAL_DATA_DIR=.local-test-data
